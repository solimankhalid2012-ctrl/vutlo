{
  "manifest_version": 3,
  "name": "Vutlo — Smart Downloader",
  "version": "1.0.0",
  "description": "Download any video from 1000+ sites in up to 8K with no watermark.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["https://vutlo.com/*", "http://localhost:5173/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
