# ── VideoVault Pro — Backend (نموذج) ──
# انسخ إلى .env ثم املأ القيم الحقيقية. لا ترفع .env إلى Git.

PORT=4001
CLIENT_URL=http://localhost:5173

# عنوان الاستماع. 127.0.0.1 = لا يلمس الإنترنت إلا عبر nginx (الأنسب).
# 0.0.0.0 = فقط داخل Docker/WSL، وإلا صار المنفذ 4001 مفتوحاً للجميع
# فيتخطّى TLS وحدود الطلبات وضبط الـproxy.
HOST=127.0.0.1

# عدد الـproxies الموثوقة أمام السيرفر. 0 = لا نثق بأي ترويسة (نشر مباشر).
# مع nginx على نفس الجهاز ⇒ 1 (أو loopback).
# التطبيق يقرأ العنصر الأيمن من X-Forwarded-For فقط، فقيم المتصفح المزوّرة
# تُهمل، بخلاف إعداد Express الجاهز الذي يُعيد عنواناً يمكن تزويره.
# TRUST_PROXY=1

# ── 🔐 الأمان ──
# إلزامي في الإنتاج. ولّد مفتاحاً (32 بايت عشوائي):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASS_HASH=
# لتوليد هاش (ضع كلمة السر بين علامتَي تنصيص):
#   node -e "const c=require('crypto'),s=c.randomBytes(16),k=c.scryptSync('YOUR_PASSWORD',s,64,{N:16384,r:8,p:1,maxmem:67108864});console.log(['scrypt',16384,8,1,s.toString('base64url'),k.toString('base64url')].join('$'))"
# في الإنتاج: إمّا ADMIN_PASS_HASH أو ADMIN_PASS بطول 8+. الافتراضي "admin123" مرفوض.

# ── 🤖 Webhooks (اختياري — اتركها فارغة لتعطيل البوتات) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── 🛡️ حدود الطلبات ──
LOGIN_MAX_ATTEMPTS=5
# سقف ثانٍ لكل IP وحده: يمنع تخمين عناوين بريد مختلفة من جهاز واحد،
# بينما LOGIN_MAX_ATTEMPTS فوق يحمي كل حساب على حدة (IP + البريد)
# حتى لا تُقفل حسابات الأبرياء الذين يتشاركون شبكة واحدة (NAT/CGNAT).
LOGIN_IP_MAX_ATTEMPTS=25
API_MAX_PER_MIN=120
HEAVY_MAX_PER_MIN=15
CLIENT_ERROR_MAX=30
CONTACT_MAX_PER_HOUR=5
# تصويت النجوم (POST /api/rating): تغيير الرأي بضع مرّات مسموح، الحشو مرفوض
RATING_MAX_PER_10MIN=30

# ── ⬇️ yt-dlp / ffmpeg ──
YTDLP_BIN=yt-dlp
FFMPEG_PATH=ffmpeg
DOWNLOAD_DIR=./downloads
# عمر ملف التحميل قبل حذفه بالساعات. يمنع امتلاء القرص، ويحدّ عمر
# الرابط العام /files الذي بلا مصادقة. 0 أو قيمة سالبة تُتجاهل (تُستخدم 6).
FILE_TTL_HOURS=6
MAX_CONCURRENT=4
YTDLP_JS_RUNTIME=node
# YTDLP_COOKIES=./cookies.txt

# ── ⬆️ رفع الملفات الدائمة (/api/upload و /api/gif-local) ──
# السقوف بالميغابايت. الزائر 50MB، والحساب 200MB. الخادم هو المرجع النهائي
# (UPLOAD_MAX_BYTES في server/services/uploadStore.js يقرأ أعلى الحدّين).
UPLOAD_MAX_MB_GUEST=50
UPLOAD_MAX_MB_USER=200
# حدود عدد الطلبات بالساعة لكل IP: رفع 30 و GIF محلي 20. ارفعها بحذر —
# كل عملية تستهلك قرصاً دائماً (downloads/uploads لا يمرّ عليها منظّف الاستبقاء).
UPLOAD_MAX_PER_HOUR=30
GIF_LOCAL_MAX_PER_HOUR=20

# ── 🗄️ قاعدة البيانات ──
DATABASE_URL=file:./dev.db

# ── 🌐 روابط الواجهة (Vite) ──
# ⚠️ هذه تُقرأ وقت البناء (import.meta.env)، فبعد تغييرها أعد البناء:
#     npm run build        # الإنتاج
#     npm run dev          # التطوير (إعادة تحميل suffice)
#
# رابط الموقع الرسمي: يظهر في الفوتر وصفحة "من نحن" فقط إن كان https://.
# نتركه فارغاً بدل تخمين عنوان ⇒ لا يظهر رابط مزيّف لصفحات عامة.
VITE_SITE_URL=
# حسابات المشروع (نفس المبدأ: لا تُعرض إلا ما ضُبط فعلاً)
# VITE_SOCIAL_GITHUB=
# VITE_SOCIAL_X=
# VITE_SOCIAL_DISCORD=
# عنوان الـAPI منفصل: اتركه فارغاً في التطوير (الـproxy في vite.config.js)،
# واضبطه في الإنتاج إن كان الخادم على نطاق مختلف.
# VITE_API_URL=https://your-domain.com
