# ── VideoVault Pro — Backend (نموذج) ──
# انسخ إلى .env ثم املأ القيم الحقيقية. لا ترفع .env إلى Git.

PORT=4001
CLIENT_URL=http://localhost:5173

# ── 🔐 الأمان ──
# إلزامي في الإنتاج. ولّد مفتاحاً (32 بايت عشوائي):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASS_HASH=
# لتوليد هاش (ضع كلمة السر بين علامتَي تنصيص):
#   node -e "const c=require('crypto'),s=c.randomBytes(16),k=c.scryptSync('YOUR_PASSWORD',s,64,{N:16384,r:8,p:1,maxmem:67108864});console.log(['scrypt',16384,8,1,s.toString('base64url'),k.toString('base64url')].join('$'))"
# في الإنتاج: إمّا ADMIN_PASS_HASH أو ADMIN_PASS بطول 8+. الافتراضي "admin123" مرفوض.

# ── 🤖 Webhooks (اختياري — اتركها فارغة لتعطيل البوتات) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── 🛡️ حدود الطلبات ──
LOGIN_MAX_ATTEMPTS=5
# سقف ثانٍ لكل IP وحده: يمنع تخمين عناوين بريد مختلفة من جهاز واحد،
# بينما LOGIN_MAX_ATTEMPTS فوق يحمي كل حساب على حدة (IP + البريد)
# حتى لا تُقفل حسابات الأبرياء الذين يتشاركون شبكة واحدة (NAT/CGNAT).
LOGIN_IP_MAX_ATTEMPTS=25
API_MAX_PER_MIN=120
HEAVY_MAX_PER_MIN=15
CLIENT_ERROR_MAX=30
CONTACT_MAX_PER_HOUR=5

# ── ⬇️ yt-dlp / ffmpeg ──
YTDLP_BIN=yt-dlp
FFMPEG_PATH=ffmpeg
DOWNLOAD_DIR=./downloads
# عمر ملف التحميل قبل حذفه بالساعات. يمنع امتلاء القرص، ويحدّ عمر
# الرابط العام /files الذي بلا مصادقة. 0 أو قيمة سالبة تُتجاهل (تُستخدم 6).
FILE_TTL_HOURS=6
MAX_CONCURRENT=4
YTDLP_JS_RUNTIME=node
# YTDLP_COOKIES=./cookies.txt

# ── 🗄️ قاعدة البيانات ──
DATABASE_URL=file:./dev.db
