{
  "name": "videovault-pro",
  "version": "1.0.0",
  "description": "VideoVault Pro — Smart Link Recognition Engine for downloading videos from 1000+ sites without watermark. React + Node + yt-dlp.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "lint": "eslint src server --ext .js,.jsx",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\""
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "framer-motion": "^11.2.10",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.4",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "video-downloader",
    "tiktok-no-watermark",
    "youtube-downloader",
    "yt-dlp",
    "pwa",
    "mp3-converter"
  ],
  "license": "MIT"
}
